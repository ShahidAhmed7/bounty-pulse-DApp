# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
#
# `.env` is gitignored - never commit the real JWT.
# Vite only exposes variables prefixed with VITE_ to browser code.

# Pinata JWT, from https://app.pinata.cloud/developers/api-keys
# NOTE: anything VITE_-prefixed is bundled into the JavaScript and is visible to
# anyone who opens devtools. That is acceptable for this coursework demo, but a
# production app would proxy Pinata uploads through a backend so the key stays secret.
VITE_PINATA_JWT=

# Optional. Leave blank to use the default fresh-Anvil address baked into
# src/contract/config.js. Set this only if your deployment landed elsewhere.
VITE_CONTRACT_ADDRESS=
